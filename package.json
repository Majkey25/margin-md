{
  "name": "margin-md",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Local Markdown editor and preview for Chrome",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/files.test.ts",
    "test:browser": "npm run build && node --import tsx --test tests/browser.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/css": "1.3.9",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "1.3.13",
    "@lezer/javascript": "1.5.6",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/chrome": "^0.3.7",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/wicg-file-system-access": "^2023.10.7",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
